{
  "name": "<%= name %>",
  "version": "0.0.0",
  "description": "The default blueprint for Embroider v2 addons.",
  "keywords": [
    "ember-addon"
  ],
  "repository": "",
  "license": "MIT",
  "author": "",
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup --config",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"<%= packageManager %>:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"<%= packageManager %>:lint:*:fix\" --names \"fix:\" --prefixColors auto && <%= packageManager %> run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:js": "eslint .<% if (!typescript) { %> --cache<% } %>",
    "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js:fix": "eslint . --fix<% if (typescript) { %>",
    "lint:types": "ember-tsc --noEmit<% } %>",
    "lint:publish": "<%= runScript %> build && publint run --level error",
    "start": "vite dev",
    "test": "vite build --mode=development --out-dir dist-tests && testem --file testem.cjs ci --port 0",
    "prepack": "rollup --config"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.11.0",
    "decorator-transforms": "^2.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.1.2<% if (typescript) { %>",
    "@babel/plugin-transform-typescript": "^8.1.3<% } %>",
    "@babel/runtime": "^8.1.3",
    "@ember/app-tsconfig": "^2.1.0",
    "@ember/library-tsconfig": "^3.0.0",
    "@ember/test-helpers": "^5.8.0",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/addon-dev": "^8.5.0",
    "@embroider/compat": "^4.1.28",
    "@embroider/core": "^4.6.10",
    "@embroider/macros": "^1.21.4",
    "@embroider/vite": "^1.8.1",
    "@eslint/js": "^10.0.1",
    "@glimmer/component": "^2.2.1<% if (typescript) { %>",
    "@glint/ember-tsc": "^1.14.4",
    "@glint/template": "^1.11.1",
    "@glint/tsserver-plugin": "^2.7.17<% } %>",
    "@rollup/plugin-babel": "^7.1.0<% if (typescript) { %>",
    "@types/qunit": "^2.19.14<% } %>",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "concurrently": "^10.0.7",
    "ember-qunit": "^9.2.1",
    "ember-source": "^7.4.1",
    "ember-strict-application-resolver": "^0.1.1",
    "ember-template-lint": "^7.9.4",
    "ember-page-title": "^9.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.11.4",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "publint": "^0.3.25",
    "qunit": "^3.0.0",
    "qunit-dom": "^3.6.0",
    "rollup": "^4.68.8",
    "testem": "^3.21.5<% if (typescript) { %>",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0<% } %>",
    "vite": "^8.3.8"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "<% if (typescript) { %>types": "./declarations/index.d.ts",
      "<% } %>default": "./dist/index.js"
    },
    "./addon-main.js": "./addon-main.cjs",
    "./*.css": "./dist/*.css",
    "./*": {
      "<% if (typescript) { %>types": "./declarations/*.d.ts",
      "<% } %>default": "./dist/*.js"
    }
  }
}
